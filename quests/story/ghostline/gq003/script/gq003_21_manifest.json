      "string_id": "4265535868367535955",
      "speaker": "Patch",
      "addressee": "V",
      "text": "Four sealed cases. Two dead drops. No names.",
      "audio_path": "mod\\gq003\\localization\\en-us\\vo\\gq003_23_patch_runs_answer.wem",
      "duration_ms": 3200,
      "beat": "van_entry"
    },
