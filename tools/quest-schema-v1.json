{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostline.local/schemas/quest-v1.json",
  "title": "Ghostline typed quest manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "phase_prefabs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#"
      }
    },
    "debug_fact": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "baseStage": {
      "type": "object",
      "required": [
        "id",
        "type",
        "phase_resource"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "phone_job_offer",
            "meet_contact",
            "hack_access_point",
            "deliver_drop_point",
            "phone_conversation",
            "reach_area",
            "leave_area",
            "acquire_item",
            "read_shard",
            "interact_device",
            "combat_encounter",
            "investigate_clues",
            "optional_condition",
            "choice_gate",
            "escort_npc",
            "carry_npc",
            "deliver_vehicle",
            "time_gate",
            "read_terminal_document",
            "stealth_monitor",
            "plant_item",
            "defend_target",
            "release_or_rescue_npc",
            "enter_vehicle",
            "ride_with_contact",
            "drive_to",
            "steal_vehicle",
            "vehicle_cleanup"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "planned"
          ],
          "default": "ready"
        },
        "phase_resource": {
          "$ref": "#/$defs/depotPath"
        },
        "phase_template": {
          "$ref": "#/$defs/depotPath"
        },
        "inherit_phase_prefabs": {
          "type": "boolean",
          "default": true
        },
        "template_bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "required_assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/depotPath"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "stage": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "meet_contact"
                },
                "contact": {
                  "type": "string",
                  "minLength": 1
                },
                "scene": {
                  "$ref": "#/$defs/depotPath"
                },
                "community": {
                  "type": "string",
                  "minLength": 1
                },
                "appearance": {
                  "type": "string"
                },
                "objective": {
                  "type": "string",
                  "minLength": 1
                },
                "description_entry": {
                  "type": "string",
                  "minLength": 1
                },
                "mappin": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "contact",
                "scene",
                "community",
                "objective",
                "description_entry",
                "mappin"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "phone_job_offer"
                },
                "contact": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "choice_group": {
                  "type": "string",
                  "minLength": 1
                },
                "accept_choice": {
                  "type": "string",
                  "minLength": 1
                },
                "start_fact": {
                  "type": "string",
                  "minLength": 1
                },
                "accepted_fact": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "contact",
                "message",
                "choice_group",
                "accept_choice",
                "start_fact",
                "accepted_fact"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "hack_access_point"
                },
                "device": {
                  "type": "string",
                  "minLength": 1
                },
                "success_fact": {
                  "type": "string",
                  "minLength": 1
                },
                "guard_community": {
                  "type": "string"
                },
                "grants": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "device",
                "success_fact"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "deliver_drop_point"
                },
                "item": {
                  "type": "string",
                  "minLength": 1
                },
                "drop_point": {
                  "type": "string",
                  "minLength": 1
                },
                "deposit_fact": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "item",
                "drop_point",
                "deposit_fact"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "phone_conversation"
                },
                "contact": {
                  "type": "string",
                  "minLength": 1
                },
                "thread": {
                  "type": "string",
                  "minLength": 1
                },
                "messages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "opening_branches": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "condition",
                      "messages"
                    ],
                    "properties": {
                      "condition": {
                        "$ref": "#/$defs/factName"
                      },
                      "messages": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "choice_group": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "choice",
                      "reply"
                    ],
                    "properties": {
                      "choice": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reply": {
                        "type": "string",
                        "minLength": 1
                      },
                      "set_fact": {
                        "$ref": "#/$defs/factName"
                      }
                    }
                  }
                },
                "final_message": {
                  "type": "string",
                  "minLength": 1
                },
                "completion_fact": {
                  "type": "string",
                  "minLength": 1
                },
                "complete_quest": {
                  "type": "string",
                  "minLength": 1
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "mappin": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "reward": {
                  "$ref": "#/$defs/tweakDbId"
                },
                "delay_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 1
                }
              },
              "required": [
                "contact",
                "thread",
                "messages",
                "choice_group",
                "choices",
                "final_message"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "reach_area"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "mappin": {
                  "$ref": "#/$defs/journalPath"
                },
                "trigger": {
                  "$ref": "#/$defs/nodeRef"
                },
                "start_fact": {
                  "$ref": "#/$defs/factName"
                },
                "disable_previous_mappins": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "objective",
                "description_entry",
                "mappin",
                "trigger"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "leave_area"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "trigger": {
                  "$ref": "#/$defs/nodeRef"
                },
                "mappin": {
                  "$ref": "#/$defs/journalPath"
                },
                "cleanup_community": {
                  "$ref": "#/$defs/nodeRef"
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "required": [
                "objective",
                "description_entry",
                "trigger"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "acquire_item"
                },
                "item": {
                  "$ref": "#/$defs/tweakDbId"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "source": {
                  "enum": [
                    "inventory",
                    "grant"
                  ]
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "mappin": {
                  "$ref": "#/$defs/journalPath"
                },
                "acquisition_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "required": [
                "item",
                "source"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "read_shard"
                },
                "journal_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "file_entry_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "item": {
                  "$ref": "#/$defs/tweakDbId"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                },
                "acquisition_fact": {
                  "$ref": "#/$defs/factName"
                },
                "presentation_delay_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "activate_entry": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "item",
                "journal_entry",
                "file_entry_index"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "interact_device"
                },
                "device": {
                  "$ref": "#/$defs/nodeRef"
                },
                "controller_class": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "completion_function": {
                  "type": "string",
                  "minLength": 1
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "mappin": {
                  "$ref": "#/$defs/journalPath"
                },
                "success_fact": {
                  "$ref": "#/$defs/factName"
                },
                "send_action": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "device",
                "controller_class",
                "action",
                "completion_function"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "combat_encounter"
                },
                "community": {
                  "$ref": "#/$defs/nodeRef"
                },
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "activate": {
                  "type": "boolean",
                  "default": true
                },
                "hostility": {
                  "enum": [
                    "neutral_to_hostile",
                    "already_hostile"
                  ]
                },
                "completion": {
                  "enum": [
                    "all_defeated",
                    "named_defeated",
                    "fact"
                  ]
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                },
                "nonlethal_allowed": {
                  "type": "boolean",
                  "default": true
                },
                "cleanup_on_exit": {
                  "type": "boolean",
                  "default": false
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "trigger": {
                  "$ref": "#/$defs/nodeRef"
                }
              },
              "required": [
                "community",
                "hostility",
                "completion"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "completion": {
                        "const": "named_defeated"
                      }
                    },
                    "required": [
                      "completion"
                    ]
                  },
                  "then": {
                    "required": [
                      "entries"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "completion": {
                        "const": "fact"
                      }
                    },
                    "required": [
                      "completion"
                    ]
                  },
                  "then": {
                    "required": [
                      "completion_fact"
                    ]
                  }
                }
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "investigate_clues"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "clues": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/clue"
                  }
                },
                "required_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "required": [
                "objective",
                "description_entry",
                "clues"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "optional_condition"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "condition": {
                  "$ref": "#/$defs/condition"
                },
                "success_fact": {
                  "$ref": "#/$defs/factName"
                },
                "failure_fact": {
                  "$ref": "#/$defs/factName"
                },
                "evaluation": {
                  "enum": [
                    "continuous",
                    "at_exit"
                  ]
                }
              },
              "required": [
                "objective",
                "condition",
                "success_fact",
                "failure_fact",
                "evaluation"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "choice_gate"
                },
                "gate_kind": {
                  "enum": [
                    "phone_choice",
                    "fact",
                    "scene_exit"
                  ]
                },
                "branches": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/choiceBranch"
                  }
                },
                "default_branch": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "join": {
                  "const": true
                }
              },
              "required": [
                "gate_kind",
                "branches",
                "join"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "escort_npc"
                },
                "community": {
                  "$ref": "#/$defs/nodeRef"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1
                },
                "destinations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/nodeRef"
                  }
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "failure_fact": {
                  "$ref": "#/$defs/factName"
                },
                "allow_combat_interrupt": {
                  "type": "boolean",
                  "default": true
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "required": [
                "community",
                "entry",
                "destinations",
                "objective",
                "completion_fact"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "carry_npc"
                },
                "community": {
                  "$ref": "#/$defs/nodeRef"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1
                },
                "destination": {
                  "$ref": "#/$defs/nodeRef"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "placement_slot": {
                  "type": "string",
                  "minLength": 1
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "required": [
                "community",
                "entry",
                "destination",
                "objective"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "deliver_vehicle"
                },
                "vehicle": {
                  "$ref": "#/$defs/nodeRef"
                },
                "destination": {
                  "$ref": "#/$defs/nodeRef"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "mappin": {
                  "$ref": "#/$defs/journalPath"
                },
                "require_player_exit": {
                  "type": "boolean",
                  "default": true
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "required": [
                "vehicle",
                "destination",
                "objective"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "time_gate"
                },
                "days": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "hours": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "days"
                  ]
                },
                {
                  "required": [
                    "hours"
                  ]
                },
                {
                  "required": [
                    "minutes"
                  ]
                },
                {
                  "required": [
                    "seconds"
                  ]
                }
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
                  "const": "read_terminal_document"
                },
                "computer": {
                  "$ref": "#/$defs/nodeRef"
                },
                "scene": {
                  "$ref": "#/$defs/depotPath"
                },
                "output_socket": {
                  "type": "string",
                  "minLength": 1
                },
                "document_entry": {
                  "$ref": "#/$defs/journalPath"
                },
                "completion_fact": {
                  "$ref": "#/$defs/factName"
                },
                "objective": {
                  "$ref": "#/$defs/journalPath"
                },
                "description_entry": {
                  "$ref": "#/$defs/journalPath"
                }
              },
              "required": [
                "computer",
                "completion_fact",
                "objective"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseStage"
            },
            {
              "properties": {
                "type": {
