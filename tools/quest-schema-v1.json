    "nodeRef": {
      "type": "string",
      "pattern": "^(#|\\$/).+"
    },
    "journalPath": {
      "type": "string",
      "pattern": "^[^/]+(?:/[^/]+)+$"
    },
    "factName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "tweakDbId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z0-9_.]+$"
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fact",
            "trigger",
            "detection",
            "alarm",
            "timer"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        }
      }
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object_ref": {
          "$ref": "#/$defs/nodeRef"
        },
        "completion_fact": {
          "$ref": "#/$defs/factName"
        },
        "grant_item": {
          "type": "string",
          "minLength": 1
        },
        "journal_entry": {
          "$ref": "#/$defs/journalPath"
        },
        "mappin": {
          "$ref": "#/$defs/journalPath"
        }
      }
    },
    "choiceBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "set_fact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "set_fact": {
          "$ref": "#/$defs/factName"
        }
      }
    },
    "depotPath": {
      "type": "string",
      "pattern": "^(base|ep1|mod)\\\\"
    }
