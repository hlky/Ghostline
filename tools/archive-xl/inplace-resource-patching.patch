+void App::ResourcePatchExtension::ApplyStreamingSectorPatches(Red::worldStreamingSector* aResource)
+{
+    const auto& patchList = GetPatchList(aResource->path);
+
+    if (patchList.empty())
+        return;
+
+    auto& targetBuffer = Raw::StreamingSector::NodeBuffer::Ref(aResource);
+
+    for (const auto& patchInstance : patchList)
+    {
+        if (!patchInstance->Modifies(StreamingSectorInstanceDataProp))
+            continue;
+
+        auto patchResource = patchInstance->GetResource<Red::worldStreamingSector>();
+
+        if (!patchResource)
+            continue;
+
+        auto& patchBuffer = Raw::StreamingSector::NodeBuffer::Ref(patchResource);
+        auto patchedNodes = 0u;
+
+        for (auto& patchSetup : patchBuffer.nodeSetups)
+        {
+            auto* patchNode = patchBuffer.nodes[patchSetup.nodeIndex].instance;
+            auto* patchEntityNode = Red::Cast<Red::worldEntityNode>(patchNode);
+
+            if (!patchEntityNode || !patchEntityNode->instanceData)
+                continue;
+
+            for (auto& targetSetup : targetBuffer.nodeSetups)
+            {
+                const auto sameGlobalID = targetSetup.globalNodeID == patchSetup.globalNodeID;
+                const auto sameTransform =
+                    std::memcmp(&targetSetup.transform, &patchSetup.transform, sizeof(targetSetup.transform)) == 0;
+                auto* targetCandidate = targetBuffer.nodes[targetSetup.nodeIndex].instance;
+                const auto sameNodeType =
+                    targetCandidate && targetCandidate->GetNativeType() == patchNode->GetNativeType();
+
+                if (!sameGlobalID && !(sameTransform && sameNodeType))
+                    continue;
+
+                auto* targetEntityNode = Red::Cast<Red::worldEntityNode>(targetCandidate);
+
+                if (!targetEntityNode)
+                    break;
+
+                auto instanceData = Red::MakeHandle<Red::entEntityInstanceData>();
+                Red::CopyBuffer(instanceData->buffer, patchEntityNode->instanceData->buffer);
+                targetEntityNode->instanceData = std::move(instanceData);
+                ++patchedNodes;
+                LogInfo(
+                    R"([{}] Matched sector node: target ID {}, patch ID {}, exact ID {}, transform fallback {}.)",
+                    ExtensionName, targetSetup.globalNodeID, patchSetup.globalNodeID, sameGlobalID,
+                    !sameGlobalID && sameTransform && sameNodeType);
+                break;
+            }
+        }
+
+        LogInfo(R"([{}] Replaced instance data for {} node(s) in "{}" from "{}".)", ExtensionName, patchedNodes,
+                s_resourcePathRegistry->ResolvePathOrHash(aResource->path),
+                s_resourcePathRegistry->ResolvePathOrHash(patchResource->path));
+    }
+}
+
+void App::ResourcePatchExtension::OnStreamingSectorInplaceLoad(
+    Red::worldStreamingSectorInplaceContent* aResource, Red::ResourcePath aTargetPath)
+{
+    const auto& patchList = GetPatchList(aTargetPath);
+
+    if (patchList.empty())
+        return;
+
+    const auto targetPathStr = s_resourcePathRegistry->ResolvePathOrHash(aTargetPath);
+    LogInfo(R"([{}] Applying {} inplace resource patch(es) to "{}".)", ExtensionName, patchList.size(),
+            targetPathStr);
+
+    for (const auto& patchInstance : patchList)
+    {
+        if (!patchInstance->Modifies(StreamingSectorInplaceResourcesProp))
+            continue;
+
+        auto patchResource = patchInstance->GetResource<Red::worldStreamingSectorInplaceContent>();
+
+        if (!patchResource)
+            continue;
+
+        const auto patchPathStr = s_resourcePathRegistry->ResolvePathOrHash(patchResource->path);
+
+        for (const auto& patchInplace : patchResource->inplaceResources)
+        {
+            if (patchInplace.path.IsEmpty())
+                continue;
+
+            auto replaced = false;
+
+            for (auto& targetInplace : aResource->inplaceResources)
+            {
+                if (targetInplace.path == patchInplace.path)
+                {
+                    targetInplace = patchInplace;
+                    replaced = true;
+                    break;
+                }
+            }
+
+            const auto inplacePathStr = s_resourcePathRegistry->ResolvePathOrHash(patchInplace.path);
+
+            if (replaced)
+            {
+                LogInfo(R"([{}] Inplace resource "{}" from "{}" replaced the matching resource in "{}".)",
+                        ExtensionName, inplacePathStr, patchPathStr, targetPathStr);
+            }
+            else
+            {
+                aResource->inplaceResources.PushBack(patchInplace);
+                LogInfo(R"([{}] Inplace resource "{}" from "{}" added to "{}".)",
+                        ExtensionName, inplacePathStr, patchPathStr, targetPathStr);
             }
         }
     }
