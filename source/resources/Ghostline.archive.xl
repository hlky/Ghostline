  - path: mod\gq001\phases\gq001.questphase
    parent: base\quest\cyberpunk2077.quest
  - path: mod\gq002\phases\gq002.questphase
    parent: base\quest\cyberpunk2077.quest
  - path: mod\gqt001_signal_delay\phases\gqt001_signal_delay.questphase
    parent: base\quest\cyberpunk2077.quest
journal:
- mod\gq000\journal\gq000.journal
- mod\gq001\journal\gq001.journal
- mod\gq002\journal\gq002.journal
- mod\gqt001\journal\gqt001.journal
localization:
  onscreens:
    en-us:
    - mod\ghostline\localization\en-us\onscreens\ghostline.json
    - mod\gq000\localization\en-us\onscreens\gq000.json
    - mod\gq001\localization\en-us\onscreens\gq001.json
    - mod\gq002\localization\en-us\onscreens\gq002.json
    - mod\gqt001\localization\en-us\onscreens\gqt001.json
  subtitles:
