        "Data": {
          "$type": "localizationPersistenceOnScreenEntries",
          "entries": [
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The Machine Stops",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Meet Cinder.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_01_objective_meet_cinder"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Patch's client is waiting in Kabuki. Find out what Common Ground wants.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_01_description_meet_cinder"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Cinder",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_01_mappin_cinder"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Go to the Kabuki relay.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_02_objective_reach_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Common Ground traced the tenant-surveillance network to an old neighborhood relay.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_02_description_reach_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Surveillance relay",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_02_mappin_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Inspect the relay network.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_03_objective_investigate"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Scan the linked antenna access points and determine what the relay controls.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_03_description_investigate"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Tenant classifier",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_03_mappin_tenant"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Clinic telemetry bridge",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_03_mappin_medical"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Failover invoice",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_03_mappin_invoice"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Read the archived conversation.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_04_objective_read_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The recovered messages explain why the relay was designed to be difficult to remove.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_04_description_read_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Return to the target relay.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_4b_objective_return_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Go back to the relay and deal with its security.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_4b_description_return_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Target relay",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_4b_mappin_return_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Neutralize the relay security.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_05_objective_clear_security"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The relay's owners sent Tyger Claw muscle to protect their investment.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_05_description_clear_security"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Relay security",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_05_mappin_security"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Jack in to the relay.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_06_objective_operate_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Carry out the shutdown plan you chose with Cinder.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_06_description_operate_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Relay access point",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_06_mappin_operate"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Leave the relay area.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_07_objective_leave_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Put some distance between yourself and the relay while Cinder verifies the result.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_07_description_leave_relay"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Respond to Cinder.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_08_objective_respond_cinder"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Read Cinder's message and let her know where you stand.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_08_description_respond_cinder"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The Machine Stops",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_start_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Got a client with a machine problem. Common Ground. Meet Cinder in Kabuki and hear her out.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_msg_cinder"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "On my way.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_choice_on_my_way"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Hostage Circuit",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_relay_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Saw the scan. Tenant classifier and clinic telemetry share one relay. Deliberate hostage circuit.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_relay_hostage"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Two options: destroy it after I warn the clinic, or blind the classifier and spoof a failure.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_relay_choose"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Destroy the relay.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_choice_destroy"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Spoof the shutdown.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_choice_spoof"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Hard stop. I'll warn the clinic and reroute what I can before you pull it.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_relay_destroy_reply"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Quiet cut. I'll feed the owners a clean failure report while you blind the classifier.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_relay_spoof_reply"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Make the call real. Jack in.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_relay_proceed"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Common Ground",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The relay is off their board. Clinic traffic is stable and the tenant feed is dead.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_outcome"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Common Ground owes you. The owners will call it vandalism. The tenants get to call it privacy.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_context"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Hard shutdown confirmed. The clinic made the reroute; the surveillance relay stayed dead.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_destroy_confirm"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Spoof held. Their dashboard sees a dead relay while the clinic traffic keeps moving.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_spoof_confirm"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Machines don't get a vote.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_choice_hard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Keep the clinic safe.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_choice_careful"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Neither do landlords who wire medicine to surveillance.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_hard_reply"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Already watching the reroute. I don't spend lives to make a point.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_careful_reply"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "There are more hostage circuits in this city. I'll call when we find the next one.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_phone_debrief_more_work"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Archived conversation: Sato and Keene",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_shard_hostage_circuit_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "[SATO] Tenant classifier is live. Missed payments, unauthorized occupants, behavioral flags. All routed through the Kabuki relay.\n\n[KEENE] And the clinic telemetry?\n\n[SATO] Same failover bus. If anyone cuts surveillance, the clinic loses remote diagnostics.\n\n[KEENE] Good. Make removal expensive enough that activists have to choose who gets hurt.\n\n[SATO] Tyger Claws are billing for on-site security.\n\n[KEENE] Approve it. Fear is cheaper than rebuilding.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq002_shard_hostage_circuit_body"
            }
          ]
        }
      }
    },
    "EmbeddedFiles": []
  }
}
