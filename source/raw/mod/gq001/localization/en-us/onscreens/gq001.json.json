      "root": {
        "HandleId": "0",
        "Data": {
          "$type": "localizationPersistenceOnScreenEntries",
          "entries": [
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Ghostline",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Meet Patch at the bridge.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_01_objective_meet_patch"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Patch is waiting with the details of a quiet job. Hear him out.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_01_description_meet_patch"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Patch",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_01_poi_patch_bridge"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Patch's meeting point",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_01_mappin_patch_bridge"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Patch",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_patch_name"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Bridge Work",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_start_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Got a quiet job if you're still taking those. Meet me at the bridge. Come alone.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_msg_patch_bridge"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "On my way.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_choice_on_my_way"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Go to the cache coordinates.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_objective_reach_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Patch gave you the first cache location. Get there and see what is waiting.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_description_reach_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Cache coordinates",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_mappin_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Extract the datacache.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_objective_extract_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Connect to the relay and breach its access point. The Tyger Claws do not need to be dead, but they will not make it easy.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_description_extract_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Leave the relay area.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_objective_leave_area"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "You have the datacache. Put some distance between yourself and the relay before the Tyger Claws regroup.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_02_description_leave_area"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Archived conversation: Seki and K. Morita",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_shard_quiet_spine_01_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "SEKI: Node six is carrying double tonight.\nK. MORITA: Then split it between two couriers.\nSEKI: Flesh couriers? Thought Quiet Spine stayed on the wire.\nK. MORITA: Nothing stays on the wire through inspection. First courier carries the cipher. Second carries the memory. Neither knows the other.\nSEKI: And if the Claws open them?\nK. MORITA: Then your fee becomes an apology to my employer.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_shard_quiet_spine_01_body"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Archived conversation: Hiromi and K. Morita",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_shard_quiet_spine_02_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "HIROMI: Little China relay is burned. Someone pinged the old municipal line.\nK. MORITA: Move the next packet to Japantown. Quiet Spine, route C.\nHIROMI: Drop is a braindance editor?\nK. MORITA: The editor thinks she is cleaning signal noise. The courier thinks he is moving scop. Keep it that way.\nHIROMI: And the source?\nK. MORITA: Above your invoice.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_shard_quiet_spine_02_body"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Morrow",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_morrow_name"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Quiet Spine",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_delivery_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Cache authenticated. Clean extraction.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_morrow_cache_authenticated"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Iris found a courier route folded into the payload. You brought us more than Patch promised.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_morrow_route_found"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Then pay me for it.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_choice_pay_me"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "What kind of route?",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_choice_what_route"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Already adjusted. Ghostline rewards useful surprises.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_morrow_pay_adjusted"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Names without faces, handoffs without addresses. Enough to know the route is still live.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_morrow_route_explained"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Keep this number. When we find the other end, I may need someone who works outside the wire.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_phone_morrow_more_work"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Deliver the datacache to the drop point.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_04_objective_deliver_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Take the datacache to Ghostline's drop point in Kabuki and deposit it.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_04_description_deliver_cache"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Drop point",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_04_mappin_drop_point"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Datacache",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_item_datacache_name"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Meet Iris.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_03_objective_meet_iris"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Iris can make sense of the recovered cache. Bring it to her.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_03_description_meet_iris"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Iris",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq001_03_mappin_iris"
            }
          ]
        }
      }
    },
    "EmbeddedFiles": []
  }
}
