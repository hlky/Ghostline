            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Read Goth Baddie's datashard",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_02_objective_read_goth_baddie_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The shard was still recording when Goth Baddie went down.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_02_description_read_goth_baddie_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Leave the area",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_03_objective_leave_goth_baddie_site"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Get clear while Patch isolates Goth Baddie's combat telemetry.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_03_description_leave_goth_baddie_site"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Report to Patch",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_04_objective_report_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Tell Patch what happened to Goth Baddie.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_04_description_report_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "GOTH BADDIE // DEADMAN LOOP",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_shard_goth_baddie_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Combat telemetry repeats one instruction: HOLD THE LINE. Friendly signatures disappear one by one, but the loop keeps assigning new targets. The final entries are scarred by self-targeting ICE.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_shard_goth_baddie_body"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Goth Baddie",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_report_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "I saw the spike drop. Tell me Goth Baddie's status.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_status"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "She's dead. The shard was still recording.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_killed"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Alive. Unconscious. The shard was still recording.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_spared"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Sending the shard.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_choice_send_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "What happened to her?",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_choice_ask_context"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Got it. I'll isolate the deck and scrub your signature.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_reply_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Someone trained her nervous system to treat every connection as an attack. I'll find out who.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_reply_context"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Get clear. Payment's sent.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_complete"
            }
          ]
        }
