            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "A Ghostline netrunner has gone over the edge. Stop her before the feedback loop spreads.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_01_description_neutralize_goth_baddie"
