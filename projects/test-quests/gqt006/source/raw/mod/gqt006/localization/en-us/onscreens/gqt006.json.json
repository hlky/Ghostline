          "entries": [
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Cyberpsycho Sighting: Goth Baddie",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Neutralize Goth Baddie",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_01_objective_neutralize_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Regina sent an NCPD Cyberpsycho alert from Kabuki. Neutralize Goth Baddie, and keep her alive if you can.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_01_description_neutralize_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Goth Baddie",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_01_mappin_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Read Goth Baddie's datashard",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_02_objective_read_goth_baddie_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "The shard was still recording when Goth Baddie went down.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_02_description_read_goth_baddie_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Leave the area",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_03_objective_leave_goth_baddie_site"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Get clear while Regina's people secure the scene.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_03_description_leave_goth_baddie_site"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Report to Regina",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_04_objective_report_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Send Regina Goth Baddie's status and recovered telemetry.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_04_description_report_goth_baddie"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Cyberpsycho Sighting: Goth Baddie",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_report_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "NCPD flagged another cyberpsycho in Kabuki. Calls herself Goth Baddie. Heavily chromed, armed with a katana, and she's already put down the first-response team. Take her alive if you can. Sending coordinates.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_brief"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Combat spike just dropped. Status?",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_status"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "She's dead. Found a shard still recording.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_killed"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Alive. Situation's contained. Found a shard still recording.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_spared"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Fight went her way. I called the deal off and she stood down. She's alive. Found a shard still recording.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_truce"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Sending the shard now.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_choice_send_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Any idea what pushed her over?",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_choice_ask_context"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Got it. Clear the area—my people are on their way.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_reply_shard"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Not yet. Send me the shard. If someone rewired her threat response, I want a name.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_reply_context"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Payment's transferred.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_phone_msg_complete"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "GOTH BADDIE // DEADMAN LOOP",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_shard_goth_baddie_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Combat telemetry repeats one instruction: HOLD THE LINE. Friendly signatures disappear one by one, but the loop keeps assigning new targets. The final entries are scarred by self-targeting ICE.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gqt006_shard_goth_baddie_body"
            }
          ]
        }
      }
    },
