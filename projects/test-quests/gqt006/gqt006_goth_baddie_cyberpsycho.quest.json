          "id": "regina_jones"
        },
        "threads": {
          "report": {
            "id": "gqt006_04_report",
            "title": "Cyberpsycho Sighting: Goth Baddie",
            "title_key": "gl_gqt006_phone_report_title",
            "template": {
              "donor": "regina_cyberpsycho",
              "id": "ma_wat_kab_08"
            },
            "entries": {
              "ncpd_brief": {
                "type": "message",
                "id": "00_msg_ncpd_brief",
                "text": "NCPD flagged another cyberpsycho in Kabuki. Calls herself Goth Baddie. Heavily chromed, armed with a katana, and she's already put down the first-response team. Take her alive if you can. Sending coordinates.",
                "localization_key": "gl_gqt006_phone_msg_brief",
                "template": {
                  "donor": "regina_cyberpsycho",
                  "id": "00_msg_intro"
                },
                "delay": 3,
                "important": true,
                "attachment": "@quest.path"
              },
              "status": {
                "type": "message",
                "id": "01_msg_status",
                "text": "Combat spike just dropped. Status?",
                "localization_key": "gl_gqt006_phone_msg_status"
              },
              "killed": {
                "type": "message",
                "id": "02a_msg_killed",
                "text": "She's dead. Found a shard still recording.",
                "localization_key": "gl_gqt006_phone_msg_killed",
                "sender": "Player"
              },
              "spared": {
                "type": "message",
                "id": "02b_msg_spared",
                "text": "Alive. Situation's contained. Found a shard still recording.",
                "localization_key": "gl_gqt006_phone_msg_spared",
                "sender": "Player"
              },
              "truce": {
                "type": "message",
                "id": "02c_msg_truce",
                "text": "Fight went her way. I called the deal off and she stood down. She's alive. Found a shard still recording.",
                "localization_key": "gl_gqt006_phone_msg_truce",
                "sender": "Player"
              },
              "response": {
                "type": "choice_group",
                "id": "03_ch_response",
                "entries": {
                  "send_shard": {
                    "id": "03a_ch_send_shard",
                    "text": "Sending the shard now.",
                    "localization_key": "gl_gqt006_phone_choice_send_shard"
                  },
                  "ask_context": {
                    "id": "03b_ch_ask_context",
                    "text": "Any idea what pushed her over?",
                    "localization_key": "gl_gqt006_phone_choice_ask_context"
                  }
                }
              },
              "shard": {
                "type": "message",
                "id": "04a_msg_shard",
                "text": "Got it. Clear the area—my people are on their way.",
                "localization_key": "gl_gqt006_phone_reply_shard"
              },
              "context": {
                "type": "message",
                "id": "04b_msg_context",
                "text": "Not yet. Send me the shard. If someone rewired her threat response, I want a name.",
                "localization_key": "gl_gqt006_phone_reply_context"
              },
              "complete": {
                "type": "message",
                "id": "05_msg_complete",
                "text": "Payment's transferred.",
                "localization_key": "gl_gqt006_phone_msg_complete"
              }
            }
          }
        }
      }
