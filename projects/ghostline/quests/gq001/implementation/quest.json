        "threads": {
          "gq001_05_delivery": {
            "id": "gq001_05_delivery",
            "title": "Quiet Spine",
            "title_key": "gl_gq001_phone_delivery_title",
            "entries": {
              "entry_01_msg_cache_authenticated": {
                "type": "message",
                "id": "01_msg_cache_authenticated",
                "localization_key": "gl_gq001_phone_morrow_cache_authenticated",
                "text": "Cache authenticated. Clean extraction.",
                "delay": 1
              },
              "entry_02_msg_route_found": {
                "type": "message",
                "id": "02_msg_route_found",
                "localization_key": "gl_gq001_phone_morrow_route_found",
                "text": "Iris found a courier route folded into the payload. You brought us more than Patch promised.",
                "delay": 2
              },
              "entry_03_ch_delivery_response": {
                "type": "choice_group",
                "id": "03_ch_delivery_response",
                "entries": {
                  "entry_03a_ch_pay_me": {
                    "id": "03a_ch_pay_me",
                    "text": "Then pay me for it.",
                    "localization_key": "gl_gq001_phone_choice_pay_me"
                  },
                  "entry_03b_ch_what_route": {
                    "id": "03b_ch_what_route",
                    "text": "What kind of route?",
                    "localization_key": "gl_gq001_phone_choice_what_route"
                  }
                }
              },
              "entry_04a_msg_pay_adjusted": {
                "type": "message",
                "id": "04a_msg_pay_adjusted",
                "localization_key": "gl_gq001_phone_morrow_pay_adjusted",
                "text": "Already adjusted. Ghostline rewards useful surprises.",
                "delay": 1
              },
              "entry_04b_msg_route_explained": {
                "type": "message",
                "id": "04b_msg_route_explained",
                "localization_key": "gl_gq001_phone_morrow_route_explained",
                "text": "Names without faces, handoffs without addresses. Enough to know the route is still live.",
                "delay": 1
              },
              "entry_05_msg_more_work": {
                "type": "message",
                "id": "05_msg_more_work",
                "localization_key": "gl_gq001_phone_morrow_more_work",
                "text": "Keep this number. When we find the other end, I may need someone who works outside the wire.",
                "delay": 2
              }
            }
          }
        },
        "name": "Morrow"
      }
    },
    "readables": {
      "quiet_spine_01": {
        "kind": "onscreen",
        "group": "shards",
        "id": "quiet_spine_01",
        "title": "Archived conversation: Seki and K. Morita",
        "text": "SEKI: Node six is carrying double tonight.\nK. MORITA: Then split it between two couriers.\nSEKI: Flesh couriers? Thought Quiet Spine stayed on the wire.\nK. MORITA: Nothing stays on the wire through inspection. First courier carries the cipher. Second carries the memory. Neither knows the other.\nSEKI: And if the Claws open them?\nK. MORITA: Then your fee becomes an apology to my employer.",
        "title_key": "gl_gq001_shard_quiet_spine_01_title",
        "text_key": "gl_gq001_shard_quiet_spine_01_body",
        "tag": "technology"
      },
      "quiet_spine_02": {
        "kind": "onscreen",
        "group": "shards",
        "id": "quiet_spine_02",
        "title": "Archived conversation: Hiromi and K. Morita",
        "text": "HIROMI: Little China relay is burned. Someone pinged the old municipal line.\nK. MORITA: Move the next packet to Japantown. Quiet Spine, route C.\nHIROMI: Drop is a braindance editor?\nK. MORITA: The editor thinks she is cleaning signal noise. The courier thinks he is moving scop. Keep it that way.\nHIROMI: And the source?\nK. MORITA: Above your invoice.",
        "title_key": "gl_gq001_shard_quiet_spine_02_title",
        "text_key": "gl_gq001_shard_quiet_spine_02_body",
        "tag": "technology"
      }
