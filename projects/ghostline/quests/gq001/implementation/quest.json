                "type": "message",
                "id": "01_msg_patch_bridge",
                "localization_key": "gl_gq001_phone_msg_patch_bridge",
                "text": "Got a quiet job if you're still taking those. Meet me at the bridge. Come alone.",
                "delay": 3
              },
              "entry_02_ch_meet_patch": {
