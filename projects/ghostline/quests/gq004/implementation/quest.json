    "readables": {
      "sales": {
        "kind": "onscreen",
        "group": "files",
        "id": "sales",
        "title": "HEARTBREAKER / wholesale terms",
        "text": "BROKER: Baseline drops them for six seconds.\nCLIENT: Can it keep them agreeable?\nBROKER: We removed the interrupt watchdog. Longer loops available at a premium.\nCLIENT: Send a sample.\nBROKER: No refunds for affective damage.",
        "title_key": "gl_gq004_sales_title",
        "text_key": "gl_gq004_sales_body",
        "tag": "technology"
      },
      "archive": {
        "kind": "onscreen",
        "group": "files",
        "id": "archive",
        "title": "VK / conditioning-interrupt research",
        "text": "INTENT: interrupt abusive behavioural-conditioning feedback. Never write an emotional preference.\nSUCCESS: subject regains the ability to refuse.\nABORT: return all altered values on disconnect.\nNOTE: Heartbreaker is a working title. Stop laughing.\n\nUNSENT: You said you couldn't stay angry. I believe you. When you're ready, I have something that might help.",
        "title_key": "gl_gq004_archive_title",
        "text_key": "gl_gq004_archive_body",
        "tag": "technology"
      },
      "revocation": {
        "kind": "onscreen",
        "group": "files",
        "id": "revocation",
        "title": "Deployment / preserve before patch",
        "text": "1. Copy prototype and signing key to isolated storage.\n2. Verify checksum.\n3. Upload corrected build to distributor.\n4. Revoke this stolen batch.\n5. Remove conditioning loop; retain bounded combat-system interruption.\nSafety watchdog: six seconds. Cosmetic hearts and black bows: intentional.",
        "title_key": "gl_gq004_revocation_title",
        "text_key": "gl_gq004_revocation_body",
        "tag": "technology"
      }
