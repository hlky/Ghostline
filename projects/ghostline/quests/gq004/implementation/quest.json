        "threads": {
          "offer": {
            "id": "gq004_offer",
            "title": "Somebody stole my heart",
            "title_key": "gl_gq004_offer_title",
            "entries": {
              "hello": {
                "type": "message",
                "id": "01_hello",
                "text": "Hey, gorgeous. Somebody stole my heart. Technically it's a prototype neural exploit, but that sounds less romantic. Need a favour? \u2661",
                "localization_key": "gl_gq004_01_hello",
                "delay": 1
              },
              "respond": {
                "type": "choice_group",
                "id": "02_respond",
                "entries": {
                  "accept": {
                    "id": "01_accept",
                    "text": "Send the location.",
                    "localization_key": "gl_gq004_01_accept"
                  }
                }
              }
            }
          },
          "ending": {
            "id": "gq004_ending",
            "title": "Attachments",
            "title_key": "gl_gq004_ending_title",
            "entries": {
              "goodbye": {
                "type": "message",
                "id": "01_goodbye",
                "text": "Don't get too attached, V. I'm terrible at relationships.",
                "localization_key": "gl_gq004_01_goodbye",
                "delay": 1
              },
              "reply": {
                "type": "choice_group",
                "id": "02_reply",
                "entries": {
                  "ack": {
                    "id": "01_ack",
                    "text": "Could've fooled me.",
                    "localization_key": "gl_gq004_01_ack"
                  },
                  "tease": {
                    "id": "02_tease",
                    "text": "I'll keep a backup.",
                    "localization_key": "gl_gq004_02_tease"
                  }
                }
              },
              "response_a": {
                "type": "message",
                "id": "03_response_a",
                "text": "Actually, I'm pretty good at attachments. It's the detaching that causes problems. \u2661",
                "localization_key": "gl_gq004_03_response_a",
                "delay": 1
              },
              "response_b": {
                "type": "message",
                "id": "03_response_b",
                "text": "Actually, I'm pretty good at attachments. It's the detaching that causes problems. \u2661",
                "localization_key": "gl_gq004_03_response_b",
                "delay": 1
              },
              "close": {
                "type": "message",
                "id": "04_close",
                "text": "And V? The bows are non-negotiable. \u2661",
                "localization_key": "gl_gq004_04_close",
                "delay": 1
              }
            }
          }
        }
      }
