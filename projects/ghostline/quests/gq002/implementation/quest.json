              "entry_01_msg_hostage_circuit": {
                "type": "message",
                "id": "01_msg_hostage_circuit",
                "localization_key": "gl_gq002_phone_relay_hostage",
                "text": "Saw the scan. Tenant classifier and clinic telemetry share one relay. Deliberate hostage circuit.",
                "delay": 1
              },
              "entry_02_msg_choose": {
                "type": "message",
                "id": "02_msg_choose",
                "localization_key": "gl_gq002_phone_relay_choose",
                "text": "Two options: destroy it after I warn the clinic, or blind the classifier and spoof a failure.",
                "delay": 1
              },
              "entry_03_ch_response": {
                "type": "choice_group",
                "id": "03_ch_response",
                "entries": {
                  "entry_03a_ch_destroy": {
                    "id": "03a_ch_destroy",
                    "text": "Destroy the relay.",
                    "localization_key": "gl_gq002_phone_choice_destroy"
                  },
                  "entry_03b_ch_spoof": {
                    "id": "03b_ch_spoof",
                    "text": "Spoof the shutdown.",
                    "localization_key": "gl_gq002_phone_choice_spoof"
                  }
                }
              },
              "entry_04a_msg_destroy": {
                "type": "message",
                "id": "04a_msg_destroy",
                "localization_key": "gl_gq002_phone_relay_destroy_reply",
                "text": "Hard stop. I'll warn the clinic and reroute what I can before you pull it.",
                "delay": 1
              },
              "entry_04b_msg_spoof": {
                "type": "message",
                "id": "04b_msg_spoof",
                "localization_key": "gl_gq002_phone_relay_spoof_reply",
                "text": "Quiet cut. I'll feed the owners a clean failure report while you blind the classifier.",
                "delay": 1
              },
              "entry_05_msg_proceed": {
                "type": "message",
                "id": "05_msg_proceed",
                "localization_key": "gl_gq002_phone_relay_proceed",
                "text": "Make the call real. Jack in.",
                "delay": 1
              }
            }
          },
          "gq002_08_debrief": {
            "id": "gq002_08_debrief",
            "title": "Common Ground",
            "title_key": "gl_gq002_phone_debrief_title",
            "entries": {
              "entry_01_msg_outcome": {
                "type": "message",
                "id": "01_msg_outcome",
                "localization_key": "gl_gq002_phone_debrief_outcome",
                "text": "The relay is off their board. Clinic traffic is stable and the tenant feed is dead.",
                "delay": 1
              },
              "entry_02_msg_context": {
                "type": "message",
                "id": "02_msg_context",
                "localization_key": "gl_gq002_phone_debrief_context",
                "text": "Common Ground owes you. The owners will call it vandalism. The tenants get to call it privacy.",
                "delay": 1
              },
              "entry_02a_msg_destroy_confirm": {
                "type": "message",
                "id": "02a_msg_destroy_confirm",
                "localization_key": "gl_gq002_phone_debrief_destroy_confirm",
                "text": "Hard shutdown confirmed. The clinic made the reroute; the surveillance relay stayed dead.",
                "delay": 1
              },
              "entry_02b_msg_spoof_confirm": {
                "type": "message",
                "id": "02b_msg_spoof_confirm",
                "localization_key": "gl_gq002_phone_debrief_spoof_confirm",
                "text": "Spoof held. Their dashboard sees a dead relay while the clinic traffic keeps moving.",
                "delay": 1
              },
              "entry_03_ch_response": {
                "type": "choice_group",
                "id": "03_ch_response",
                "entries": {
                  "entry_03a_ch_hard": {
                    "id": "03a_ch_hard",
                    "text": "Machines don't get a vote.",
                    "localization_key": "gl_gq002_phone_choice_hard"
                  },
                  "entry_03b_ch_careful": {
                    "id": "03b_ch_careful",
                    "text": "Keep the clinic safe.",
                    "localization_key": "gl_gq002_phone_choice_careful"
                  }
                }
              },
              "entry_04a_msg_hard": {
                "type": "message",
                "id": "04a_msg_hard",
                "localization_key": "gl_gq002_phone_debrief_hard_reply",
                "text": "Neither do landlords who wire medicine to surveillance.",
                "delay": 1
              },
              "entry_04b_msg_careful": {
                "type": "message",
                "id": "04b_msg_careful",
                "localization_key": "gl_gq002_phone_debrief_careful_reply",
                "text": "Already watching the reroute. I don't spend lives to make a point.",
                "delay": 1
              },
              "entry_05_msg_more_work": {
                "type": "message",
                "id": "05_msg_more_work",
                "localization_key": "gl_gq002_phone_debrief_more_work",
                "text": "There are more hostage circuits in this city. I'll call when we find the next one.",
                "delay": 1
              }
            }
          }
        }
      }
    },
    "readables": {
      "hostage_circuit": {
        "kind": "onscreen",
        "group": "shards",
        "id": "hostage_circuit",
        "title": "Archived conversation: Sato and Keene",
        "text": "[SATO] Tenant classifier is live. Missed payments, unauthorized occupants, behavioral flags. All routed through the Kabuki relay.\n\n[KEENE] And the clinic telemetry?\n\n[SATO] Same failover bus. If anyone cuts surveillance, the clinic loses remote diagnostics.\n\n[KEENE] Good. Make removal expensive enough that activists have to choose who gets hurt.\n\n[SATO] Tyger Claws are billing for on-site security.\n\n[KEENE] Approve it. Fear is cheaper than rebuilding.",
        "title_key": "gl_gq002_shard_hostage_circuit_title",
        "text_key": "gl_gq002_shard_hostage_circuit_body",
        "tag": "technology"
      }
    },
