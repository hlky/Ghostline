            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Somebody stole my heart",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_offer_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Hey, gorgeous. Somebody stole my heart. Technically it's a prototype neural exploit, but that sounds less romantic. Need a favour? ♡",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_01_hello"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Send the location.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_01_accept"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Attachments",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_ending_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Don't get too attached, V. I'm terrible at relationships.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_01_goodbye"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Could've fooled me.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_01_ack"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "I'll keep a backup.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_02_tease"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Actually, I'm pretty good at attachments. It's the detaching that causes problems. ♡",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_03_response_a"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Actually, I'm pretty good at attachments. It's the detaching that causes problems. ♡",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_03_response_b"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "And V? The bows are non-negotiable. ♡",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_04_close"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "HEARTBREAKER / wholesale terms",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_sales_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "BROKER: Baseline drops them for six seconds.\nCLIENT: Can it keep them agreeable?\nBROKER: We removed the interrupt watchdog. Longer loops available at a premium.\nCLIENT: Send a sample.\nBROKER: No refunds for affective damage.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_sales_body"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "VK / conditioning-interrupt research",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_archive_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "INTENT: interrupt abusive behavioural-conditioning feedback. Never write an emotional preference.\nSUCCESS: subject regains the ability to refuse.\nABORT: return all altered values on disconnect.\nNOTE: Heartbreaker is a working title. Stop laughing.\n\nUNSENT: You said you couldn't stay angry. I believe you. When you're ready, I have something that might help.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_archive_body"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Deployment / preserve before patch",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_revocation_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "1. Copy prototype and signing key to isolated storage.\n2. Verify checksum.\n3. Upload corrected build to distributor.\n4. Revoke this stolen batch.\n5. Remove conditioning loop; retain bounded combat-system interruption.\nSafety watchdog: six seconds. Cosmetic hearts and black bows: intentional.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "gl_gq004_revocation_body"
            }
          ]
        }
